{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multiplayer-setup-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "SignalingRoom"
      }
    ]
  },
  "exports": {
    "SignalingRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ROOM_TTL_SECONDS": "600",
    "ALLOWED_ORIGINS": "https://moritzbrantner.github.io,http://localhost:*,http://127.0.0.1:*"
  },
  "observability": {
    "enabled": true
  }
}

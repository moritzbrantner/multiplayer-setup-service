BIND_ADDR=127.0.0.1:8787
ROOM_TTL_SECONDS=600
CLEANUP_INTERVAL_SECONDS=30
MAX_ROOMS=10000
MAX_LOBBIES=10000
ALLOWED_ORIGINS=https://moritzbrantner.github.io

# Optional coturn REST-auth credential issuance. Configure TURN_URLS and
# TURN_SHARED_SECRET together. Keep TURN_SHARED_SECRET server-side only and
# use the same value as coturn static-auth-secret.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=replace-with-a-long-random-secret
# TURN_CREDENTIAL_TTL_SECONDS=600

RUST_LOG=info

# Per transport-client HTTP admission. These limits also apply to a reverse proxy
# as one aggregate client; enforce actual end-client limits at the proxy edge.
# Values are bounded to 1..100000. Forwarded address headers are not trusted.
HTTP_REQUESTS_PER_SECOND=120
HTTP_BURST_REQUESTS=240

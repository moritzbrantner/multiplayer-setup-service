{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": [
      "format:check",
      "typecheck",
      "lint",
      "test",
      "build"
    ],
    "integration": [
      "test:integration"
    ],
    "e2e": [
      "test:e2e"
    ],
    "performance": [
      "benchmark:smoke",
      "benchmark"
    ]
  },
  "requiredCapabilities": [
    "format:check",
    "typecheck",
    "lint",
    "test",
    "build",
    "test:integration",
    "test:e2e"
  ],
  "optionalCapabilities": [
    "benchmark:smoke",
    "benchmark"
  ],
  "capabilityCommands": {
    ".": {
      "format:check": [
        "cargo",
        "fmt",
        "--all",
        "--",
        "--check"
      ],
      "lint": [
        "cargo",
        "clippy",
        "--all-targets",
        "--all-features",
        "--locked",
        "--",
        "-D",
        "warnings"
      ],
      "test": [
        "cargo",
        "test",
        "--all-targets",
        "--all-features",
        "--locked"
      ],
      "build": [
        "cargo",
        "build",
        "--locked"
      ],
      "benchmark:smoke": [
        "cargo",
        "test",
        "--release",
        "--test",
        "performance_guardrails",
        "--locked",
        "--",
        "--nocapture"
      ],
      "benchmark": [
        "cargo",
        "test",
        "--release",
        "--test",
        "performance_guardrails",
        "--locked",
        "--",
        "--nocapture"
      ]
    },
    "web": {
      "test:integration": [
        "bun",
        "run",
        "test"
      ],
      "benchmark:smoke": [
        "bun",
        "run",
        "test:perf"
      ],
      "typecheck": [
        "bun",
        "run",
        "typecheck"
      ]
    },
    "e2e": {
      "test:e2e": [
        "bun",
        "run",
        "test"
      ]
    }
  }
}
